DATABASE_URL=jdbc:postgresql://localhost:5432/sender
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
PRESENCE_STORE=redis
PRESENCE_SESSION_TTL=90s
PRESENCE_SWEEP_MS=15000
RATE_LIMIT_PRESENCE_HEARTBEAT_MAX_HITS=120

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

FRONTEND_URL=http://localhost:3000

S3_BUCKET=your-bucket-name
S3_REGION=ap-southeast-2
S3_PUBLIC_BASE_URL=https://your-bucket-name.s3.ap-southeast-2.amazonaws.com
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=replace-with-iam-secret-access-key
AVATAR_MAX_BYTES=2097152
ATTACHMENT_MAX_BYTES=10485760
RATE_LIMIT_ATTACHMENT_UPLOAD_MAX_HITS=30
RATE_LIMIT_ATTACHMENT_DOWNLOAD_MAX_HITS=60
RATE_LIMIT_ATTACHMENT_LIST_MAX_HITS=30
